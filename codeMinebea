function uploadMediaToDrive(base64Data, fileName, isImage) {
  try {
    var folderId = "11eTo7X-xeLe7WGnPOyNnF4_DS8qNkPbf";
    var folder = DriveApp.getFolderById(folderId);
    
    var splitBase = base64Data.split(',');
    var type = splitBase[0].split(';')[0].replace('data:', '');
    var blob = Utilities.newBlob(Utilities.base64Decode(splitBase[1]), type, fileName);
    var file = folder.createFile(blob);
    
    // 🌟 แก้ไข: ใช้ Try-Catch หุ้มไว้ และเปลี่ยนเป็นแชร์แค่ระดับองค์กร (DOMAIN_WITH_LINK)
    // เพื่อไม่ให้ขัดกับ IT Policy ของบริษัท และป้องกัน Error ค้าง
    try {
      file.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW);
    } catch(sharingError) {
      // ถ้าตั้งค่าแชร์ไม่ได้ให้ปล่อยผ่านไปเลย เพราะไฟล์จะได้รับสิทธิ์การมองเห็น
      // ตามสิทธิ์ของโฟลเดอร์ 1MTriHD_k4b5c3LOUHsvqKJY2nW6ArqxN อัตโนมัติอยู่แล้ว
    }
    
    if (isImage) {
      return "https://drive.google.com/thumbnail?id=" + file.getId() + "&sz=w1000";
    } else {
      return file.getUrl();
    }
  } catch (e) {
    throw new Error(e.message);
  }
}
